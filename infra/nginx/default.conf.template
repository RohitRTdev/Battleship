map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream frontend_upstream {
    server frontend:${FRONTEND_PORT};
}

upstream auth_upstream {
    server auth-service:8080;
    keepalive 8;
}

upstream control_upstream {
    zone control_upstream 64k;
    server control-node-1:8080 max_fails=2 fail_timeout=5s;
    server control-node-2:8080 max_fails=2 fail_timeout=5s;
    server control-node-3:8080 max_fails=2 fail_timeout=5s;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    location = /gateway-healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/auth/ {
        proxy_pass http://auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Authorization $http_authorization;
        proxy_next_upstream error timeout;
    }

    location /api/backend/ {
        proxy_pass http://control_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 65s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Authorization $http_authorization;
        proxy_next_upstream error timeout;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
