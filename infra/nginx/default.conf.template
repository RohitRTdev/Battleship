map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream frontend_upstream {
    server frontend:${FRONTEND_PORT};
}

upstream auth_upstream {
    server auth-service:8080;
    keepalive 8;
}

upstream backend_upstream {
    zone backend_upstream 64k;
    server backend-node-1:8080 max_fails=2 fail_timeout=5s;
    server backend-node-2:8080 max_fails=2 fail_timeout=5s;
    server backend-node-3:8080 max_fails=2 fail_timeout=5s;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    location = /gateway-healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/auth/ {
        proxy_pass http://auth_upstream;
        proxy_http_version 1.1;
    }

    location /api/backend/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 65s;
        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
